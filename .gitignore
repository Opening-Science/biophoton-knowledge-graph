# --- local environment / secrets -------------------------------------------
.venv/
__pycache__/
*.pyc
.DS_Store
.openalex_key
.openalex_mailto

# --- OpenAlex harvest cache + working DB ------------------------------------
# ~12 GB, keyed by entity id and fully rebuildable by rerunning the pipeline.
biophoton-fieldmap/data/cache/
biophoton-fieldmap/data/db/

# --- bulk intermediate exports ----------------------------------------------
# Rebuildable (build_db.py / networks.py). Also holds contacts.csv and
# contacts_fetch_log.json, which carry corresponding-author email addresses.
# Those are INTERNAL to OSF and must never be published — see
# biophoton-fieldmap/NOTES_data_ethics.md.
biophoton-fieldmap/data/exports/

# --- researcher tables that still carry the internal email column -----------
# The published equivalents are the email-stripped tables in the Zenodo
# release, produced by src/build_release.py.
biophoton-fieldmap/outputs/researchers*.csv

# --- build artifacts too large or too derived for git -----------------------
# The full data release is deposited on Zenodo (see CITATION.cff); regenerate
# it locally with `python src/build_release.py`.
biophoton-fieldmap/outputs/release/
biophoton-fieldmap/outputs/*.zip
biophoton-fieldmap/outputs/biophoton-field-map-v*/
biophoton-fieldmap/outputs/papers/
biophoton-fieldmap/outputs/index/

# Superseded duplicate of Biophoton_Field_Map_Report.html
biophoton-fieldmap/outputs/field_map_report.html

# --- literature corpus -------------------------------------------------------
# Several GB of open-access PDFs plus hand-collected books and papers. The PDFs
# are rebuildable (src/harvest_oa_pdfs.py, then src/consolidate_literature.py)
# and some carry publisher licences that are fine to read but not to
# redistribute, so only the index and manifests are tracked -- they carry every
# work id, DOI, checksum and source URL needed to reconstruct the folder.
literature/*
!literature/INDEX.md
!literature/manifest.csv
!literature/curated.csv
!literature/zotero_library.csv
!literature/zotero_watch.csv
!literature/ZOTERO_WATCH.md

# Machine-local literature source roots + OSF-internal document list
.literature_sources.json

# --- book-planning internal documents ----------------------------------------
# Candid per-person assessments used for interview planning stay local by
# editorial decision; the published planning outputs are
# open_research_questions.md and open_question_statements.md.
biophoton-fieldmap/outputs/book_planning/chapter_author_refinement.md
biophoton-fieldmap/outputs/book_planning/chapter_evidence.md

# Local Claude Code settings
.claude/settings.local.json
.gstack/
